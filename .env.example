# 스포츠브릿지 환경 변수 예시. 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올리지 않습니다)

ENV=development            # development면 uvicorn 자동 재시작(app/ 감시)
HOST=127.0.0.1
PORT=7004
BASE_URL=http://localhost:7004
APP_NAME=스포츠브릿지
# 운영 환경에서 BASE_URL은 실제 HTTPS 주소, ALLOWED_HOSTS는 허용할 호스트 이름으로 지정합니다.
# ALLOWED_HOSTS=example.org

# MongoDB (인증이 있으면 mongodb://user:pass@host:27017/?authSource=admin 형식)
MONGO_URI=mongodb://localhost:27017
DB_NAME=sportsbridge
# 공단 원본 CSV 폴더. git에는 .csv.gz로 들어 있으며 그대로 읽습니다. 압축을 풀어 .csv를 두면 .csv를 먼저 씁니다.
DATA_RAW_DIR=./data/raw

# 합성 데이터 모드. true면 화면 전체에 "합성 데이터" 표시가 붙습니다.
DEMO_MODE=false

# OpenAI API. 키가 없으면 LLM 기능(추출·문서·에이전트)만 꺼지고 나머지는 동작합니다.
LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL_MAIN=gpt-5.6-luna
LLM_MODEL_BULK=gpt-5.6-luna
LLM_DAILY_BUDGET_USD=10
LLM_REASONING_EFFORT=low
LLM_PROMPT_VERSION=v1
AGENT_MAX_TURNS=10
AGENT_TIME_BUDGET_SECONDS=90

# 담당자 화면 인증. false이면 담당자 기능에 로그인 없이 접근할 수 있습니다.
# true로 바꾸기 전에 루트 계정 아이디와 12자 이상의 비밀번호를 설정하세요.
ADMIN_AUTH_ENABLED=false
ADMIN_ROOT_USERNAME=admin
ADMIN_ROOT_PASSWORD=

# 관리자 가입 이메일 확인에 사용하는 Gmail 계정과 앱 비밀번호.
# SMTP_USERNAME에는 앱 비밀번호를 발급받은 계정의 전체 이메일 주소를 입력합니다.
# 실제 값은 .env에만 보관하세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
