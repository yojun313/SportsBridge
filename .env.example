# 스포츠브릿지 환경 변수 예시. 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 git에 올리지 않습니다)

ENV=development            # development면 uvicorn 자동 재시작(app/ 감시)
HOST=127.0.0.1
PORT=7004
BASE_URL=http://localhost:7004
APP_NAME=스포츠브릿지

# MongoDB (인증이 있으면 mongodb://user:pass@host:27017/?authSource=admin 형식)
MONGO_URI=mongodb://localhost:27017
DB_NAME=sportsbridge
# 공단 원본 CSV 폴더. git에는 .csv.gz로 들어 있으며 그대로 읽습니다. 압축을 풀어 .csv를 두면 .csv를 먼저 씁니다.
DATA_RAW_DIR=./data/raw

# 합성 데이터 모드. true면 화면 전체에 "합성 데이터" 표시가 붙습니다.
DEMO_MODE=false

# OpenAI API. 키가 없으면 LLM 기능(추출·문서·에이전트)만 꺼지고 나머지는 동작합니다.
LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL_MAIN=gpt-5.6-luna
LLM_MODEL_BULK=gpt-5.6-luna
LLM_DAILY_BUDGET_USD=10
LLM_REASONING_EFFORT=low
LLM_PROMPT_VERSION=v1
AGENT_MAX_TURNS=10
AGENT_TIME_BUDGET_SECONDS=90

# 선택: 데이터 관리 화면의 업로드·전체 재적재를 보호하는 토큰. 비우면 보호하지 않습니다.
ADMIN_TOKEN=
